# SITE_ADDRESS берётся из .env (его пишет deploy.sh из deploy.conf):
#   test.example.com  → автоматический HTTPS (Let's Encrypt)
#   :80               → просто http по IP, без домена
{$SITE_ADDRESS::80} {
	encode gzip
	reverse_proxy app:8000
}

# n8n (отдельный compose в /opt/n8n, общая docker-сеть proxy)
n8n.144-31-229-139.sslip.io {
	encode gzip
	reverse_proxy n8n:5678
}
